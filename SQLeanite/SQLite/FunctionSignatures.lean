def matchesArity (declared : Int) (actual : Nat) : Bool :=
  if declared ≥ 0 then declared == Int.ofNat actual
  else if declared == -1 then true
  else declared < -2 && actual ≥ (-2 - declared).toNat

/-- A fixed-arity overload wins over the variadic one; MIN/MAX with one
argument are aggregates even though their variadic overload is scalar. -/
def scalar (name : String) (arity : Nat) : Bool :=
  let exact := entries.filter (fun entry => entry.1 == name && entry.2.2 == Int.ofNat arity)
  if exact.isEmpty then
    entries.any (fun entry => entry.1 == name && entry.2.1 && matchesArity entry.2.2 arity)
  else exact.any (fun entry => entry.2.1)

theorem matchesArity_exact (arity : Nat) : matchesArity (Int.ofNat arity) arity = true := by
  simp [matchesArity]

