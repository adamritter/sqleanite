def expectSQLiteJsonSubtype : IO Unit := do
  for (expression, expected) in (sqliteJsonSubtypeCases0 ++ sqliteJsonSubtypeCases250 ++ sqliteJsonSubtypeCases500 ++ sqliteJsonSubtypeCases750 ++ sqliteJsonSubtypeCases1000) do
    let sql := "SELECT typeof(" ++ expression ++ "),subtype(" ++ expression ++ "),hex(" ++ expression ++ "),hex(quote(" ++ expression ++ "));"
    match CoreSQL.execute Core.State.empty sql with
    | .error message => unless expected == "error:" ++ SQLite.Text.hexBytes (SQLite.Diagnostic.bytes message) do
        fail s!"JsonSubtype error differs: {sql}: {message}"
    | .ok (_, results) =>
        let fields := expected.splitOn "|"
        let values ← (fields.zipIdx).mapM fun (field, index) => do
          let input : Value ← if index == 1 then
              match field.toInt? with
              | some integer => pure (.integer integer)
              | none => fail "invalid oracle subtype field"
            else pure (.text field)
          match SQLSurface.value input with
          | .ok value => pure value | .error message => fail message
        unless results.getLast?.map (·.rows) == some [values] do
          fail s!"JsonSubtype value/subtype differs: {sql}"

def expectSQLiteJsonRuntime : IO Unit := do
  for group in [sqliteJsonRuntimeCases0,sqliteJsonRuntimeCases200,sqliteJsonRuntimeCases400,sqliteJsonRuntimeCases600,sqliteJsonRuntimeCases800,sqliteJsonRuntimeCases1000,sqliteJsonRuntimeCases1200,sqliteJsonRuntimeCases1400] do
    for (sql, expected) in group do
      let actual : Except String String := do
        let (_, results) ← CoreSQL.execute Core.State.empty sql
        let lines ← results.flatMap (·.rows) |>.mapM fun row => do
          let values ← row.mapM fun value => do
            let value ← CoreExpr.value value
            pure (String.fromUTF8! (ByteArray.mk (SQLite.Text.bytes value)))
          pure (String.intercalate "|" values ++ "\n")
        pure (SQLite.Text.hexBytes (String.join lines).toUTF8.data)
      let output := match actual with
        | .ok value => value
        | .error message => "error:" ++ SQLite.Text.hexBytes (SQLite.Diagnostic.bytes message)
      unless output == expected do fail s!"JSON runtime subtype differs: {sql}: {output}"

