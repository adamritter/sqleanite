def expectSQLiteCreateSource : IO Unit := do
  for (source, expected) in sqliteCreateSourceCases do
    let (state, _) ← match CoreSourceSQL.execute Core.State.empty source with
      | .ok result => pure result | .error message => fail s!"source execution failed: {source}: {message}"
    let some table := state.database.findTable? "t" | fail "created table is missing"
    unless SQLite.Text.hexBytes table.catalogSQL.toUTF8.data == expected do
      fail s!"source execution changed catalog SQL: {source}"
    let some image := CoreFile.encode state.database | fail "source-aware state cannot be encoded"
    let some reopened := CoreDecode.decode image.fileBytes | fail "source-aware state cannot be reopened"
    unless reopened.Equiv state.database do fail "source-aware catalog round trip differs"
    if let some sequence := state.database.findTable? "sqlite_sequence" then
      unless sequence.catalogSQL == "CREATE TABLE sqlite_sequence(name,seq)" do
        fail "sqlite_sequence catalog SQL differs"
    let duplicate := "CREATE TABLE \"t\"(other INTEGER);"
    match CoreSourceSQL.execute state duplicate with
    | .ok _ => fail "duplicate table source unexpectedly succeeded"
    | .error message => unless message == "table \"t\" already exists" do
        fail s!"duplicate table source error differs: {message}"

