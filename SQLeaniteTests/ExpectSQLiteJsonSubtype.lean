    | .ok value => pure value | .error message => fail message
  for (sql, expected) in sqliteJsonGroupInsertPreparationCases do
    match CoreSQL.execute arityState sql with
    | .error message => unless message == expected do fail s!"INSERT preparation diagnostic differs: {sql}: {message}"
    | .ok _ => fail s!"Invalid INSERT preparation was accepted: {sql}"

