  for (setup, sql, values, expectedError) in cases do
    let (state, _) ← match CoreSQL.execute Core.State.empty setup with
      | .ok result => pure result | .error message => fail message
    let statements ← match CoreTokenGrammar.parseStatements sql with
      | .ok result => pure result | .error message => fail message
    let (rows, message) := match statements.toList with
      | [.select query] =>
          match CoreSQL.observeReadSelect? state query with
          | some report => (report.execution.result.rows, report.error)
          | none => match CoreSQL.executeSelect state query with
            | .error error => ([], some error)
            | .ok result => (result.result.rows, none)
      | _ => match CoreSQL.execute state sql with
          | .error error => ([], some error)
          | .ok (_, results) => ((results.getLast?.map (·.rows)).getD [], none)
    let expected ← match values.mapM (List.mapM SQLSurface.value) with
      | .ok rows => pure rows | .error message => fail message
    unless rows == expected && message == some expectedError do
      fail s!"percentile execution differs from C: {sql}: {message}"

end SQLeanite.Tests
