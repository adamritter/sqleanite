  for (setup, sql, expectedError, values) in cases do
    let (state, _) ← match CoreSQL.execute Core.State.empty setup with
      | .ok result => pure result
      | .error message => fail message
    let statements ← match CoreTokenGrammar.parseStatements sql with
      | .ok result => pure result
      | .error message => fail message
    let [.select query] := statements.toList | fail "single prefix fixture was not a SELECT"
    let ordinary := CoreSQL.executeSelect state query
    let (rows, failed) := match CoreSQL.observeReadSelect? state query with
      | some report => (report.execution.result.rows, report.error.isSome)
      | none => match ordinary with
        | .ok execution => (execution.result.rows, false)
        | .error _ => ([], true)
    let expected ← match values.mapM (List.mapM SQLSurface.value) with
      | .ok rows => pure rows
      | .error message => fail message
    unless rows == expected && failed == expectedError do
      fail s!"single-source prefix or status differs: {sql}"
    unless ordinary.isOk == !failed do
      fail "single-source observation changed the ordinary execution result"

end SQLeanite.Tests
