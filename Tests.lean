      \"id\"\"key\" INTEGER PRIMARY KEY,\"value,part\" TEXT NOT NULL);
    CREATE INDEX \"idx\"\"comma,\" ON \"odd\"\"table,one\"(\"value,part\");
    INSERT INTO \"odd\"\"table,one\" VALUES(1,'kept');"
