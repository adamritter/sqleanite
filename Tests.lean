  let (state, _) ← match CoreSQL.execute Core.State.empty setup with
    | .ok result => pure result | .error message => fail message
  let cases : List (String × String) := [
    ("SELECT median(CASE WHEN id=1 THEN 'x' ELSE v END) FROM t WHERE CASE WHEN id=3 THEN abs(-9223372036854775808) ELSE 1 END;", "input to median() is not numeric"),
