    {
      "stage": "Added coroutine and register boundary probes",
      "cases": 88,
      "failures": 2,
      "reason": "INSERT SELECT into a trigger-free body target was always materialized. SQLite instead streams plain SELECT-star-over-VALUES input, exposing the prior inserted rowid to later source rows. A target with matching INSERT triggers materializes the same input first."
    },
    {
      "stage": "Shared coroutine admission plus triggered-target control",
      "cases": 90,
      "failures": 0
